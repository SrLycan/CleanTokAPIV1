# Plantilla de producción. deploy/instalar-vps.sh la copia a .env y rellena las claves con valores aleatorios.

# --- Dominio que atiende Caddy ---
# <ip-con-guiones>.sslip.io (gratis, HTTPS), tu dominio con un registro A a la IP, o :80 (solo HTTP)
DOMINIO=1-2-3-4.sslip.io
# Va dentro de los QR: {CLEANTOK_URL_PUBLICA}/q/{token}
CLEANTOK_URL_PUBLICA=https://1-2-3-4.sslip.io

# --- Base de datos (solo en la red interna de Docker) ---
DB_NAME=cleantok
DB_USER=cleantok
DB_PASSWORD=se-genera-al-instalar

# --- Seguridad ---
JWT_SECRET=se-genera-al-instalar
CLEANTOK_SUPERADMIN_EMAIL=superadmin@cleantok.ec
CLEANTOK_SUPERADMIN_PASSWORD=se-genera-al-instalar
# Panel web futuro, separado por comas (ej.: https://app.midominio.com)
CLEANTOK_CORS_ORIGENES=

# --- "demo" carga empresas, proveedores y 60 días de movimientos para que el equipo pruebe. "default" = vacío ---
SPRING_PROFILES_ACTIVE=demo

# --- Extracción de materiales con IA (opcional) ---
CLEANTOK_IA_HABILITADA=false
ANTHROPIC_API_KEY=
CLEANTOK_IA_MODELO=claude-opus-5-5

# --- App Links de Android (opcional) ---
CLEANTOK_ANDROID_PAQUETE=ec.cleantok.app
CLEANTOK_ANDROID_SHA256=

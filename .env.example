# Copia este archivo a .env y ajusta los valores. Todos tienen un valor por defecto para la demo local.

# --- Base de datos (PostgreSQL 16; compatible con Supabase o Neon) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cleantok
DB_USER=cleantok
DB_PASSWORD=cleantok

# --- Seguridad ---
# Mínimo 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-de-desarrollo-de-32-bytes-o-mas!!
# Orígenes permitidos para el panel web (separados por coma)
CLEANTOK_CORS_ORIGENES=http://localhost:5173,http://localhost:3000
# SUPER_ADMIN inicial: se crea al arrancar solo si no existe
CLEANTOK_SUPERADMIN_EMAIL=superadmin@cleantok.ec
CLEANTOK_SUPERADMIN_PASSWORD=SuperAdmin2026!

# --- URL pública que va dentro de los QR: {CLEANTOK_URL_PUBLICA}/q/{token} ---
# En la demo por LAN usa la IP de tu PC, por ejemplo http://192.168.1.50:8080
CLEANTOK_URL_PUBLICA=http://localhost:8080

# --- Extracción de materiales con IA (opcional; la demo funciona sin ella) ---
CLEANTOK_IA_HABILITADA=false
ANTHROPIC_API_KEY=
CLEANTOK_IA_MODELO=claude-opus-5-5
CLEANTOK_IA_TIMEOUT_SEG=60

# --- Reglas de negocio ---
CLEANTOK_DIAS_COBERTURA_MIN=7
# Tras un CONSUMO se sugiere reportar nivel si el piso queda en esta fracción del último traslado o menos
CLEANTOK_UMBRAL_SUGERENCIA_NIVEL=0.25

# --- Alertas: job que reevalúa la cobertura (cron de Spring, hora de Ecuador) ---
CLEANTOK_ALERTAS_JOB=true
CLEANTOK_ALERTAS_CRON=0 0 * * * *

# --- Archivos (PDF de órdenes y fotos): local (por defecto) o supabase ---
ALMACENAMIENTO_TIPO=local
ALMACENAMIENTO_RUTA=./almacenamiento
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# --- Perfil: "demo" carga los datos semilla (empresas, establecimientos y 60 días de movimientos) ---
SPRING_PROFILES_ACTIVE=demo

# --- App Links de Android (opcional): publica /.well-known/assetlinks.json ---
CLEANTOK_ANDROID_PAQUETE=
# Huellas SHA-256 del certificado de firma, separadas por coma (formato AA:BB:...)
CLEANTOK_ANDROID_SHA256=
